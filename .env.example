# Doceree CI — local environment template
# Copy to .env and fill in values for local testing.
# In CI, these are injected from GitHub repo secrets via the workflow env block.
# .env is gitignored — never commit real secrets.

# --- LLM providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Gmail (OAuth refresh-token flow) ---
# CLIENT_ID + CLIENT_SECRET come from the Google Cloud OAuth Client (Desktop App type)
# REFRESH_TOKEN is generated once via scripts/generate_gmail_token.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# --- Telegram (Sev-5 alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
